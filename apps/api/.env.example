PORT=4000
# Bind address; loopback by default, set to the Tailscale IP to expose on the tailnet
HOST=127.0.0.1
# Port must match MONGO_HOST_PORT used with docker compose (default 27017)
MONGO_URL=mongodb://127.0.0.1:27017/redhunter
JWT_SECRET=change-me-to-a-long-random-string
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
# on | off - off disables the event outbox dispatcher
EVENTS_DISPATCH=on
# Comma list of exact web origins allowed to open Socket.IO (no wildcard, no path)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
